#include <windows.h>
#include <commctrl.h>
#include "resource_ids.h"
#pragma code_page(65001)

STRINGTABLE
BEGIN
    IDS_FULLSCREEN_MONITOR "屏幕选择"
    IDS_FULLSCREEN_DISPLAY "显示器"
    IDS_FULLSCREEN_PRIMARY "主显示器"
    IDS_FULLSCREEN_ALBUM "专辑图片"
    IDS_FULLSCREEN_ALBUM_GROUP "专辑图片背景"
    IDS_FULLSCREEN_ALBUM_FALLBACK "备用图片:"
    IDS_FULLSCREEN_ALBUM_BROWSE "浏览…"
    IDS_FULLSCREEN_ALBUM_CLEAR "清除"
    IDS_FULLSCREEN_ALBUM_TRANSPARENCY "透明度:"
    IDS_FULLSCREEN_ALBUM_PICKER "选择无专辑封面时使用的备用图片"
    IDS_FULLSCREEN_ALBUM_FILTER "图片文件"
    IDS_FULLSCREEN_LYRIC_DRAG "允许拖拽歌词"
    IDS_DESKTOP_LYRIC_ZOOM_IN "放大歌词"
    IDS_DESKTOP_LYRIC_ZOOM_OUT "缩小歌词"
    IDS_LYRIC_SERVICES_EDIT "编辑列表"
    IDS_LYRIC_SERVICES_LOADING "正在读取歌词服务器列表…"
    IDS_LYRIC_SERVICES_READONLY "DLL 内置服务器不可修改或删除。新增条目保存到所选 DLL 同名的 INI 文件。"
    IDS_LYRIC_SERVICES_CUSTOM "可编辑 INI 条目；地址须为兼容千千歌词搜索协议的 HTTP 或 HTTPS 服务。"
    IDS_LYRIC_SERVICES_SAVING "正在保存，请稍候…"
    IDS_LYRIC_SERVICES_SAVED "列表已保存，下次搜索立即生效。"
    IDS_LYRIC_SERVICES_DISCARD "放弃尚未保存的服务器列表更改？"
    IDS_LYRIC_SERVICES_NAME "名称"
    IDS_LYRIC_SERVICES_URL "地址"
    IDS_LYRIC_SERVICES_STORAGE "保存位置（只读）"
    IDS_LYRIC_SERVICES_NEW "新服务器"
    IDS_LYRIC_SERVICES_EMPTY "未加载歌词搜索 DLL，无法添加服务器。"
    IDS_LYRIC_SERVICES_UP "上移"
    IDS_LYRIC_SERVICES_DOWN "下移"
    IDS_LYRIC_SERVICES_ADD "新增"
    IDS_LYRIC_SERVICES_DELETE "删除"
    IDS_ASSOCIATION_VIEW_SYSTEM "Win7 以上系统需要手动关联"
    IDS_ASSOCIATION_USER_CHOICE "已注册可打开的音频格式。默认播放器需要在 Windows 的系统关联界面中由您确认；返回后列表将显示实际关联状态。"
    IDS_ASSOCIATION_SUPPRESS "不再提示关联提醒"
    IDS_ASSOCIATION_REFRESH "刷新"
    IDS_ASSOCIATION_OPEN_SETTINGS "前往系统设置"
    IDS_LYRIC_UPLOAD_LOADING "正在打开歌词上传页面…"
    IDS_LYRIC_UPLOAD_READY "已填入歌曲信息和歌词，请在网页中确认并提交。"
    IDS_LYRIC_UPLOAD_UNAVAILABLE "上传页面不可用或不兼容，未提交歌词。"
    IDS_LYRIC_UPLOAD_NO_SERVER "请先在歌词搜索中选择有效的 HTTP 或 HTTPS 服务器。"
END

IDD_LYRIC_SERVICES DIALOGEX 0, 0, 280, 220
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "编辑歌词服务器列表"
FONT 9, "宋体"
BEGIN
    CONTROL "", IDC_LYRIC_SERVICES_LIST, "SysListView32", WS_BORDER | WS_TABSTOP | LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS, 8, 8, 245, 90
    PUSHBUTTON "", IDC_LYRIC_SERVICES_ADD, 257, 8, 15, 14
    PUSHBUTTON "", IDC_LYRIC_SERVICES_DELETE, 257, 22, 15, 14
    PUSHBUTTON "", IDC_LYRIC_SERVICES_UP, 257, 36, 15, 14
    PUSHBUTTON "", IDC_LYRIC_SERVICES_DOWN, 257, 50, 15, 14
    LTEXT "名称:", -1, 8, 108, 40, 12
    EDITTEXT IDC_LYRIC_SERVICES_NAME, 52, 106, 220, 14, ES_AUTOHSCROLL
    LTEXT "地址:", -1, 8, 129, 40, 12
    EDITTEXT IDC_LYRIC_SERVICES_URL, 52, 127, 220, 14, ES_AUTOHSCROLL
    LTEXT "保存位置:", -1, 8, 150, 40, 12
    EDITTEXT IDC_LYRIC_SERVICES_STORAGE, 52, 148, 220, 14, ES_AUTOHSCROLL | ES_READONLY
    LTEXT "", IDC_LYRIC_SERVICES_STATUS, 8, 172, 264, 24
    DEFPUSHBUTTON "保存", IDOK, 174, 200, 46, 14
    PUSHBUTTON "关闭", IDCANCEL, 226, 200, 46, 14
END

// TTPlayer.exe loads this exact group-icon identifier in FUN_0045FAD8 before
IDD_EXTENSION_CORRECTION DIALOGEX 0, 0, 344, 217
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "更改文件后缀"
FONT 9, "宋体"
BEGIN
    EDITTEXT IDC_EXTENSION_DETAILS, 10, 10, 324, 153, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
    LTEXT "仅更改文件名，不转换音频。取消后仍可按实际格式播放。", -1, 10, 170, 324, 14
    PUSHBUTTON "不再提示更改", IDC_EXTENSION_DISABLE_PROMPT, 10, 193, 90, 16
    PUSHBUTTON "更改后缀", IDOK, 109, 193, 70, 16
    PUSHBUTTON "加编号", IDC_EXTENSION_NUMBER, 186, 193, 70, 16
    DEFPUSHBUTTON "取消", IDCANCEL, 263, 193, 70, 16
END

// TTPlayer.exe loads this exact group-icon identifier in FUN_0045FAD8 before
// associating the resulting 16x16 HICON with command 0xE140.
128 ICON "assets/TTPlayer.ico"
// 5.7.9 COptionsAsso fallback icon indices 1 and 2 (00491213).
300 ICON "assets/AudioFile.ico"
301 ICON "assets/PlaylistFile.ico"

// New optional LAME DLL configuration; legacy AddIns keep their own dialogs.
4090 DIALOGEX 0, 0, 202, 99
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "LAME MP3"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Mode:", -1, 10, 12, 65, 12
    COMBOBOX 100, 80, 10, 110, 65, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    LTEXT "Bitrate (kbps):", -1, 10, 34, 65, 12
    COMBOBOX 101, 80, 32, 110, 110, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    LTEXT "VBR quality (0-9):", -1, 10, 56, 65, 12
    COMBOBOX 102, 80, 54, 110, 100, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    DEFPUSHBUTTON "OK", IDOK, 80, 78, 50, 14
    PUSHBUTTON "Cancel", IDCANCEL, 140, 78, 50, 14
END
